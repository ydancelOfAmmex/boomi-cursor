DECLARE @CUSTNMBR char(15)

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED

--SELECT TOP 1 @CUSTNMBR = RTRIM(CUSTNMBR) FROM RM00101 WHERE CUSTNMBR LIKE @PREFIX + '[0-9][0-9][0-9][0-9]' ORDER BY CUSTNMBR DESC

SELECT TOP 1 @CUSTNMBR = RTRIM(CUSTNMBR)  FROM (
    SELECT CUSTNMBR FROM RM00101
        UNION ALL
    SELECT CUSTNMBR FROM RM00102
        UNION ALL
    SELECT CUSTNMBR FROM RM00103
        UNION ALL
    SELECT CUSTNMBR FROM RM00101_Archive
        UNION ALL
    SELECT CUSTNMBR FROM RM00102_Archive
        UNION ALL
    SELECT CUSTNMBR FROM RM00103_Archive
        UNION ALL
    SELECT CUSTNMBR FROM SOP10100
        UNION ALL
    SELECT CUSTNMBR FROM SOP30200
        UNION ALL
    SELECT [Customer Number] FROM CUSTOMER
) AS SOP
WHERE RTRIM(CUSTNMBR) LIKE @PREFIX + '[0-9][0-9][0-9][0-9]'
GROUP BY RTRIM(CUSTNMBR)
ORDER BY RTRIM(CUSTNMBR) DESC

IF @CUSTNMBR IS NULL
    BEGIN
        SELECT RTRIM(@PREFIX)
    END
ELSE
    SELECT RTRIM(@CUSTNMBR)</sqltoexecute><parameters><parametervalue key="0" valueType="track"><trackparameter defaultValue="" propertyId="dynamicdocument.DDP-ACCOUNT_NAME_PREFIX" propertyName="Dynamic Document Property - DDP-ACCOUNT_NAME_PREFIX"/></parametervalue></parameters></sqlparameter></parametervalue></sourcevalues></documentproperty></documentproperties></configuration><dragpoints><dragpoint name="shape11.dragpoint1" toShape="shape12" x="2144.0" y="56.0"/></dragpoints></shape><shape image="dataprocess_icon" name="shape12" shapetype="dataprocess" userlabel="Assign New CUSTNMBR as DDP-NEW_CUSTNMBR" x="2160.0" y="48.0"><configuration><dataprocess><step index="1" key="1" name="Custom Scripting" processtype="12"><dataprocessscript componentId="dca9f25e-7bf4-4ae1-97b5-5a11b65d1a5a" language="groovy2" useComponent="true"><script>import java.util.Properties;
