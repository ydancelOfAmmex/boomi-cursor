	RTRIM(ISNULL(spxCustomer.Customer_Num, '')) AS [Customer_Num],
	RTRIM(ISNULL(spxCustomer.[xFreightType_CFSIA], '')) AS [xFreightType_CFSIA],
	RTRIM(ISNULL(spxCustomer.xPrimaryPool_CCM, '')) AS xPrimaryPool_CCM,
	RTRIM(ISNULL(EXT_FREIGHTSHIP.[Freight Type], '')) AS [Freight Type],
	RTRIM(ISNULL(CUSTOMER2.[Primary Pool], '')) AS [Primary Pool]
FROM RM00101 WITH(NOLOCK)
INNER JOIN spxCustomer WITH(NOLOCK) ON RM00101.CUSTNMBR = spxCustomer.[Customer_Num]
INNER JOIN EXT_FREIGHTSHIP ON spxCustomer.Customer_Num = EXT_FREIGHTSHIP.[Customer Number]
INNER JOIN CUSTOMER2 ON spxCustomer.Customer_Num = CUSTOMER2.[Customer Number]
WHERE RM00101.CUSTNMBR = ?
AND RM00101.INTEGRATIONID = ?
AND RTRIM(ISNULL(spxCustomer.[xFreightType_CFSIA], '')) &lt;&gt; ''
AND RTRIM(ISNULL(spxCustomer.xPrimaryPool_CCM, '')) &lt;&gt; ''
AND RTRIM(ISNULL(EXT_FREIGHTSHIP.[Freight Type], '')) &lt;&gt; ''
AND RTRIM(ISNULL(CUSTOMER2.[Primary Pool], '')) &lt;&gt; ''</sqltoexecute><parameters><parametervalue key="0" valueType="profile"><profileelement elementId="263" elementName="CUSTNMBR (eConnect/RMCustomerMasterType/taUpdateCreateCustomerRcd/CUSTNMBR)" profileId="44ad744e-9ecc-4c5c-a9c8-eb23eae4e74c" profileType="profile.xml"/></parametervalue><parametervalue key="1" valueType="profile"><profileelement elementId="449" elementName="INTEGRATIONID (eConnect/RMCustomerMasterType/taUpdateCreateCustomerRcd/INTEGRATIONID)" profileId="44ad744e-9ecc-4c5c-a9c8-eb23eae4e74c" profileType="profile.xml"/></parametervalue></parameters></sqlparameter></decisionvalue><decisionvalue valueType="static"><staticparameter staticproperty=""/></decisionvalue></decision></configuration><dragpoints><dragpoint identifier="true" name="shape84.dragpoint1" text="True" toShape="shape85" x="4208.0" y="344.0"/><dragpoint identifier="false" name="shape84.dragpoint2" text="False" toShape="shape86" x="4208.0" y="440.0"/></dragpoints></shape><shape image="stop_icon" name="shape85" shapetype="stop" userlabel="" x="4224.0" y="336.0"><configuration><stop continue="true"/></configuration><dragpoints/></shape><shape image="exception_icon" name="shape86" shapetype="exception" userlabel="" x="4224.0" y="432.0"><configuration><exception stopProcessReturnSingleDoc="false" stopsingledoc="true" title=""><exMessage>Freight Type or Primary Pool is not set

