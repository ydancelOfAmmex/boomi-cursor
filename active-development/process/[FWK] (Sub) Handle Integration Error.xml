                  <script><![CDATA[import java.util.Properties;
import java.io.InputStream;
import java.io.ByteArrayInputStream;
import com.boomi.execution.ExecutionUtil;

String jsonEscape(String value) {
    if (value == null) {
        return "";
    }
    return value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\r", "").replace("\n", "\\n").replace("\t", "\\t");
}

String text(Properties props, String name, String fallback) {
    String value = props.getProperty("document.dynamic.userdefined." + name);
    if (value == null || value.length() == 0) {
        return fallback;
    }
    return value;
}

for (int i = 0; i < dataContext.getDataCount(); i++) {
    InputStream is = dataContext.getStream(i);
    Properties props = dataContext.getProperties(i);

    String type = text(props, "DDP_FWK_ERROR_TYPE", "TECHNICAL");
    String code = text(props, "DDP_FWK_ERROR_CODE", "UNCLASSIFIED");
    String source = text(props, "DDP_FWK_ERROR_SOURCE", "unspecified");
    String message = text(props, "DDP_FWK_ERROR_MESSAGE", "No error message was captured");
    String processName = text(props, "DDP_FWK_PROCESS_NAME", "");
    String executionId = text(props, "DDP_FWK_EXECUTION_ID", "");
    String atomName = text(props, "DDP_FWK_ATOM_NAME", "");
    String timestamp = text(props, "DDP_FWK_ERROR_TIMESTAMP", "");
    String correlationId = text(props, "DDP_FWK_CORRELATION_ID", "");
    String httpStatus = text(props, "DDP_FWK_HTTP_STATUS", "");

    if ("UNCLASSIFIED".equals(code)) {
        String lower = message.toLowerCase();
        if (lower.indexOf("timeout") >= 0 || lower.indexOf("timed out") >= 0) {
            code = "HTTP_TIMEOUT";
        } else if (lower.indexOf("code 429") >= 0 || lower.indexOf("code 502") >= 0 || lower.indexOf("code 503") >= 0 || lower.indexOf("code 504") >= 0) {
            code = "TRANSIENT";
        } else if (lower.indexOf("code 400") >= 0 || lower.indexOf("code 401") >= 0 || lower.indexOf("code 403") >= 0 || lower.indexOf("code 404") >= 0) {
            code = "CLIENT_ERROR";
        }
    }

    if (httpStatus.length() == 0) {
        if ("BUSINESS".equals(type) || "CLIENT_ERROR".equals(code)) {
            httpStatus = "400";
        } else if ("HTTP_TIMEOUT".equals(code)) {
            httpStatus = "504";
        } else if ("TRANSIENT".equals(code)) {
            httpStatus = "503";
        } else {
            httpStatus = "500";
        }
    }

    props.setProperty("document.dynamic.userdefined.DDP_FWK_ERROR_TYPE", type);
    props.setProperty("document.dynamic.userdefined.DDP_FWK_ERROR_CODE", code);
    props.setProperty("document.dynamic.userdefined.DDP_FWK_ERROR_SOURCE", source);
    props.setProperty("document.dynamic.userdefined.DDP_FWK_ERROR_MESSAGE", message);
    props.setProperty("document.dynamic.userdefined.DDP_FWK_HTTP_STATUS", httpStatus);
    props.setProperty("document.dynamic.userdefined.DDP_FWK_CORRELATION_ID", correlationId);

    ExecutionUtil.setDynamicProcessProperty("DPP_FWK_LAST_ERROR_MESSAGE", message, false);
    ExecutionUtil.setDynamicProcessProperty("DPP_FWK_LAST_ERROR_CODE", code, false);
    ExecutionUtil.setDynamicProcessProperty("DPP_FWK_LAST_ERROR_TYPE", type, false);
    ExecutionUtil.setDynamicProcessProperty("DPP_FWK_LAST_ERROR_SOURCE", source, false);
    ExecutionUtil.setDynamicProcessProperty("DPP_FWK_LAST_HTTP_STATUS", httpStatus, false);
    ExecutionUtil.setDynamicProcessProperty("DPP_FWK_LAST_CORRELATION_ID", correlationId, false);
    ExecutionUtil.setDynamicProcessProperty("DPP_FWK_LAST_EXECUTION_ID", executionId, false);

    String json = "{\"errorType\":\"" + jsonEscape(type)
        + "\",\"errorCode\":\"" + jsonEscape(code)
        + "\",\"errorSource\":\"" + jsonEscape(source)
        + "\",\"errorMessage\":\"" + jsonEscape(message)
        + "\",\"httpStatus\":\"" + jsonEscape(httpStatus)
        + "\",\"correlationId\":\"" + jsonEscape(correlationId)
        + "\",\"processName\":\"" + jsonEscape(processName)
        + "\",\"executionId\":\"" + jsonEscape(executionId)
        + "\",\"atomName\":\"" + jsonEscape(atomName)
        + "\",\"timestamp\":\"" + jsonEscape(timestamp) + "\"}";

    dataContext.storeStream(new ByteArrayInputStream(json.getBytes("UTF-8")), props);
}]]></script>
